{
  "name": "ytmkit",
  "version": "0.2.0",
  "description": "Friendly YouTube Music library: metadata, search, playable streams, and a local stream proxy.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Piroman09/ytmkit.git"
  },
  "homepage": "https://github.com/Piroman09/ytmkit#readme",
  "bugs": {
    "url": "https://github.com/Piroman09/ytmkit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ytmkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "docs/DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "live": "vitest run tests/live.test.ts",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run check:package"
  },
  "keywords": [
    "youtube",
    "youtube-music",
    "ytmusic",
    "innertube",
    "music",
    "streaming",
    "audio",
    "proxy",
    "client",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "youtubei.js": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
